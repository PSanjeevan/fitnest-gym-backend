{
  "info": {
    "name": "FitNest Gym Locker System (NU-AIAGAI2C-G01)",
    "description": "Automated Postman test collection for FitNest Gym Locker System.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Twist Test 1: Sort Lockers by Name ASC (200, A to Z)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Lockers are sorted A to Z by name', function () {",
              "    const data = pm.response.json();",
              "    pm.expect(data.length).to.be.above(1);",
              "    pm.expect(data[0].name.localeCompare(data[1].name)).to.be.at.most(0);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/lockers?sort=name&order=asc",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["lockers"],
          "query": [
            { "key": "sort", "value": "name" },
            { "key": "order", "value": "asc" }
          ]
        }
      }
    },
